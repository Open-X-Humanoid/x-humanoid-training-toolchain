#!/usr/bin/env bash
# Run any xhum module without ``pip install -e .`` (uses this repo's ``src/`` on PYTHONPATH).
#
# Usage (from repo root or elsewhere):
#   ./scripts/xhum-run xhum.deploy.ros2_deploy --config /path/to/config.yaml
#   ./scripts/xhum-run xhum.convert.hdf5_to_lerobot --help
#
# Extra args are passed to ``python -m``.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec python -m "$@"
