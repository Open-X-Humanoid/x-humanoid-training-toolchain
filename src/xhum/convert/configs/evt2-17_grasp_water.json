{
    "dataset": {
        "fps": 30,
        "robot_type": "tienkung"
    },
    "episode_path": "trajectory.hdf5",
    "features": {
        "observation.state": {
            "dtype": "float32",
            "shape": [26],
            "names": null
        },
        "action": {
            "dtype": "float32",
            "shape": [26],
            "names": null
        },
        "observation.images.camera": {
            "dtype": "video",
            "shape": [480, 640, 3],
            "names": ["height", "width", "channels"]
        }
    },
    "mappings": [
        {
            "hdf5_keys": ["puppet/arm_left_position_align/data", "puppet/end_effector_left_position_align/data", "puppet/arm_right_position_align/data", "puppet/end_effector_right_position_align/data"],
            "feature_key": "observation.state"
        },
        {
            "hdf5_keys": ["puppet/arm_left_position_align/data", "puppet/end_effector_left_position_align/data", "puppet/arm_right_position_align/data", "puppet/end_effector_right_position_align/data"],
            "feature_key": "action"
        },
        {
            "hdf5_key": "camera_observations/color_images/camera_camera",
            "feature_key": "observation.images.camera",
            "decode": "jpeg",
            "resize": [640, 480]
        }
    ]
}
